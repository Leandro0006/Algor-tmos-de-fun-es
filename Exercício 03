#include <iostream>
using namespace std;

void preencherMatriz(int matriz[][30], int N) {
    for (int i = 0; i < N; i++)
        for (int j = 0; j < N; j++)
            if (i == j)
                matriz[i][j] = 1;
            else if (j > i)
                matriz[i][j] = 2;
            else
                matriz[i][j] = 3;
}

void imprimirMatriz(int matriz[][30], int N) {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++)
            cout << matriz[i][j] << " ";
        cout << endl;
    }
}

int main() {
    int N, matriz[30][30];
    cout << "Digite o tamanho da matriz quadrada: ";
    cin >> N;

    preencherMatriz(matriz, N);
    imprimirMatriz(matriz, N);

    return 0;
}
