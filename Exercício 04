#include <iostream>
using namespace std;

void desenharTriangulo(int linhas) {
    for (int i = 1; i <= linhas; i++) {
        for (int j = 1; j <= i; j++)
            cout << "*";
        cout << endl;
    }
}

int main() {
    int n;
    cout << "Digite o número de linhas do triângulo: ";
    cin >> n;

    desenharTriangulo(n);

    return 0;
}
